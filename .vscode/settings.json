{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "black-formatter.args": [
        "--line-length",
        "100",
        "--preview"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "telemetry.editStats.enabled": false,
    "telemetry.feedback.enabled": false,
    "cloudcode.enableTelemetry": false,
    "cloudcode.project": "daisy-tekii",
    "cloudcode.enableGkeAutopilotSupport": false,
    "cloudcode.enableMinikubeGcpAuthPlugin": true,
    "cloudcode.enable1stPartyAuth": false,
    "geminicodeassist.enableTelemetry": false,
    "geminicodeassist.codeGenerationPaneViewEnabled": true,
    "geminicodeassist.project": "daisy-tekii",
    "geminicodeassist.updateChannel": "Default",
    "geminicodeassist.verboseLogging": false,
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.maxTokenizationLineLength": 200000,
    "pylint.args": [
        "--disable=W0212",
        "--disable=C0116",
        "--disable=C0104",
        "--diable=C0114",
        "--argument-naming-style=camelCase",
    ],
    "pylint.ignorePatterns": [
        ".attic/*"
    ],
    "isort.args": [
        "--profile",
        "black"
    ],
    "isort.check": true,
    "flake8.args": [
        "--max-line-length=100"
    ],
}